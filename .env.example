# ---------------------------------------------------------------------------
# Axlori Lead Finder — environment variables (all optional)
#
# With none of these set, the app runs in DEMO MODE on generated sample data.
# Every value below is read on the SERVER only and is never sent to the browser.
#
# Setup:
#   1. cp .env.example .env.local
#   2. Uncomment / fill in the providers you want
#   3. Restart the dev server (env changes are not hot-reloaded)
#   4. Open Settings → Data sources to confirm what is active
#
# You can mix and match: each capability falls back to demo independently, and the
# sidebar shows exactly which ones are live.
# ---------------------------------------------------------------------------


# ===========================================================================
# JUST WANT REAL GOOGLE RESULTS?  Uncomment these two lines and paste your key.
# Websites + emails + WhatsApp come back as "not available" because Google does
# not publish those fields — the app says so rather than inventing them.
# ===========================================================================
# BUSINESS_DATA_PROVIDER=google_places
# BUSINESS_DATA_API_KEY=AIzaSy...


# --- Business data provider -------------------------------------------------
#   demo           (default) bundled sample data, no key, no billing
#   google_places  Google Places API (New) — official, licensed, no scraping
BUSINESS_DATA_PROVIDER=demo

# Server-only API key for the provider above.
# Google Cloud Console → APIs & Services → Credentials → Create credentials → API key.
# Requires a Google Cloud project with billing enabled and "Places API (New)" enabled.
BUSINESS_DATA_API_KEY=
# Alias also accepted: GOOGLE_PLACES_API_KEY

# Optional: override the provider base URL (self-hosted proxy, staging, …).
BUSINESS_DATA_BASE_URL=


# --- Website analysis provider ----------------------------------------------
#   demo       (default) canned, clearly-labelled sample reviews
#   pagespeed  Google PageSpeed Insights — real Lighthouse measurements of public URLs.
#              Free (25,000 requests/day, 100 per 100 seconds), no billing required.
WEBSITE_ANALYSIS_PROVIDER=demo

# Can be the same key as BUSINESS_DATA_API_KEY, but restrict it to the
# "PageSpeed Insights API" only — a separate key keeps the quotas independent.
WEBSITE_ANALYSIS_API_KEY=
# Alias also accepted: PAGESPEED_API_KEY


# --- AI provider ------------------------------------------------------------
#   demo    (default) insights composed from provider facts, no external calls
#   openai  any OpenAI-compatible chat completions endpoint
AI_PROVIDER=demo

AI_API_KEY=
# Alias also accepted: OPENAI_API_KEY
AI_MODEL=gpt-4o-mini
